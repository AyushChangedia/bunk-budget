# Copy this file to `.env` and fill in your real key.
# `.env` is gitignored, so your key never gets committed.

GROQ_API_KEY=your_groq_api_key_here

# Optional: override the vision model (defaults to llama-4-maverick).
# Alternative lighter/cheaper option: meta-llama/llama-4-scout-17b-16e-instruct
GROQ_MODEL=meta-llama/llama-4-maverick-17b-128e-instruct
