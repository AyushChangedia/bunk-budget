# Copy this file to `.env` and fill in your real key.
# `.env` is gitignored, so your key never gets committed.

GROQ_API_KEY=your_groq_api_key_here

# Optional: override the vision model (defaults to qwen/qwen3.6-27b).
# Must be a current Groq vision model — see https://console.groq.com/docs/models
# (the old Llama 4 maverick/scout vision models were deprecated in 2026).
GROQ_MODEL=qwen/qwen3.6-27b
